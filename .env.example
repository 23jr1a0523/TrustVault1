# TrustVault Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to GitHub or share secrets in chat.

# Flask Application Secret Key (generate a random 32+ character string)
SECRET_KEY=your-flask-secret-key-replace-this

# Supabase Project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Found in Supabase Project Settings -> API)
# Server-side ONLY! Never expose this on the frontend or in public repos.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Private Storage Bucket Name
SUPABASE_BUCKET=trustvault-documents

# Supabase PostgreSQL Database Connection String
# (Found in Supabase Project Settings -> Database -> Connection string -> URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Google Gemini API Key for AI Security Assistant (Optional for core auth/storage)
GEMINI_API_KEY=your-gemini-api-key-here

# Flask Environment (development or production)
FLASK_ENV=development
